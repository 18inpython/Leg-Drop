class StockTracker:
    def __init__(self, symbol):
        self.symbol = symbol
        self.ticker = yf.Ticker(symbol)

    def get_current_price(self):
        data = self.ticker.history(period="1d")
        return round(data["Close"].iloc[-1], 2)

    def save_price_to_file(self, filename="stock_log.txt"):
        price = self.get_current_price()
        timestamp = datetime.now().strftime("%Y-%m-%d %H:%M")
        with open(filename, "a") as f:
            f.write(f"{timestamp}, {self.symbol}, {price}\n")
        print(f"Logged {self.symbol}: ${price}")

    def track_multiple(self, symbols, filename="stock_log.txt"):
        for symbol in symbols:
            tracker = StockTracker(symbol)
            tracker.save_price_to_file(filename)

    def track_multiple(symbols, filename="stock_log.txt"):
        for symbol in symbols:
            tracker = StockTracker(symbol)
            tracker.save_price_to_file(filename)
